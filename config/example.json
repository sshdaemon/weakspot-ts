{
  "base": "origin/main",
  "specDepth": 1,
  "specPattern": "\\.(spec|test)\\.(ts|tsx|mts|cts)$",
  "e2ePattern": "\\.(e2e-spec|e2e|integration)\\.(ts|tsx|mts|cts)$",
  "skip": [
    "\\.(dto|entity|module|controller|enum|types|constants|config|interface|schema|migration|stories)\\.tsx?$",
    "(^|/)(index|main)\\.ts$",
    "\\.d\\.ts$",
    "(^|/)migrations/",
    "(^|/)__generated__/",
    "(^|/)(test|tests|__tests__|__mocks__)/"
  ],
  "excludedMutations": [
    "StringLiteral",
    "ObjectLiteral",
    "BlockStatement"
  ],
  "timeoutMs": 3000,
  "concurrency": 8,
  "vitest": {
    "pool": "forks"
  },
  "noise": [
    "logging",
    "errorMessage",
    "catchOnly",
    "jsxAttribute"
  ],
  "escalate": "noCoverage",
  "lanes": {
    "unit": {
      "timeoutMs": 3000
    },
    "e2e": {
      "config": "vitest.e2e.config.mts",
      "specs": {
        "map": [
          [
            "^services/(\\w+)/src/([^/]+)/",
            "services/$1/e2e/$2/*.e2e.ts"
          ]
        ]
      },
      "envPerWorker": {
        "TEST_DB": "shop_test_{worker}"
      },
      "concurrency": 4,
      "timeoutMs": 30000,
      "prepare": "npm run build --workspace packages/db"
    }
  }
}

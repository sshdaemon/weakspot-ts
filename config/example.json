{
  "base": "origin/develop",
  "specDepth": 1,
  "specPattern": "\\.(spec|test)\\.(ts|tsx|mts|cts)$",
  "e2ePattern": "\\.(e2e-spec|e2e|integration)\\.(ts|tsx|mts|cts)$",
  "skip": [
    "\\.(dto|entity|module|controller|enum|types|constants|config|interface|schema|migration|stories)\\.tsx?$",
    "(^|/)(index|main)\\.ts$",
    "\\.d\\.ts$",
    "(^|/)migrations/",
    "(^|/)__generated__/",
    "(^|/)(test|tests|__tests__|__mocks__)/"
  ],
  "excludedMutations": [
    "StringLiteral",
    "ObjectLiteral",
    "BlockStatement"
  ],
  "timeoutMs": 3000,
  "concurrency": 8,
  "vitest": {
    "pool": "forks"
  },
  "lanes": {
    "unit": {
      "timeoutMs": 3000
    },
    "e2e": {
      "config": "vitest-e2e.config.mts",
      "specs": {
        "map": [
          [
            "^apps/(\\w+)/src/([^/]+)/",
            "apps/$1/test/suites/$2/**/*.e2e-spec.ts"
          ]
        ]
      },
      "envPerWorker": {
        "E2E_DB_NAME_PREFIX": "weakspot_{worker}",
        "TEST_MAX_WORKERS": "1"
      },
      "concurrency": 2,
      "timeoutMs": 20000,
      "prepare": "pnpm --filter @acme/database build"
    }
  }
}
